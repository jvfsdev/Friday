# Copie para .env e preencha.

# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: várias chaves separadas por vírgula (cada uma de um projeto/conta
# Google diferente = cota gratuita própria). Se preenchido, substitui a de cima.
# GEMINI_API_KEYS=chave1,chave2,chave3

# Crie o bot com o @BotFather no Telegram e cole o token aqui
TELEGRAM_BOT_TOKEN=

# Seu ID numérico no Telegram (descubra falando com o @userinfobot)
TELEGRAM_USER_ID=

# Home Assistant (Fase 5 — pode deixar vazio por enquanto)
HA_URL=http://localhost:8123
HA_TOKEN=

# Notion (Fase 6): crie uma integração interna em notion.so/my-integrations,
# cole o token aqui e compartilhe suas páginas com a integração (menu ••• da página)
NOTION_TOKEN=

# Contas Microsoft/@hotmail (opcional): ID do aplicativo registrado no Azure
# (portal.azure.com → Registros de aplicativo) — guia em scripts/microsoft_auth.py
MS_CLIENT_ID=
